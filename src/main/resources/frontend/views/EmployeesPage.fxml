<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="backend.controllers.EmployeesController"
      stylesheets="@style.css" spacing="20.0" styleClass="main-content-scroll">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Управление на служители" styleClass="dashboard-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Добави служител"
                styleClass="primary-action-btn"
                onAction="#handleAddEmployee"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="filter-bar">
        <padding>
            <Insets top="10.0" right="15.0" bottom="10.0" left="15.0"/>
        </padding>
        <TextField promptText="🔍 Търси по име, потребителско име или роля..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
        <ComboBox promptText="Роля: Всички" styleClass="filter-combo"/>
    </HBox>

    <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS" styleClass="custom-table, members-table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colFirstName" text="Име" prefWidth="180.0"/>
            <TableColumn fx:id="colLastName" text="Фамилия" prefWidth="180.0"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="150.0"/>
            <TableColumn fx:id="colRole" text="Роля" prefWidth="140.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colActions" text="Действия" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label text="Показани служители" styleClass="date-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5.0" alignment="CENTER">
            <Button text="&lt;" styleClass="pagination-btn"/>
            <Button text="1" styleClass="pagination-btn, pagination-btn-active"/>
            <Button text="&gt;" styleClass="pagination-btn"/>
        </HBox>
    </HBox>
</VBox>
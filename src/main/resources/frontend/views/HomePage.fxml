<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="mainLayout" stylesheets="@style.css" prefHeight="768.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="backend.controllers.HomeController">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" prefHeight="60.0">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>
            <Label text="GYM" styleClass="logo-text"/>
            <Label text="APP" styleClass="logo-text-accent"/>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="15.0">
                <Label text="Служител: Иван Иванов (Admin)" styleClass="user-info-text"/>
                <Separator orientation="VERTICAL" prefHeight="20.0"/>
                <Label text="03 Юни 2026" styleClass="date-text"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" prefWidth="256.0" alignment="TOP_CENTER">
            <padding>
                <Insets top="20.0" bottom="20.0"/>
            </padding>

            <VBox spacing="8.0" VBox.vgrow="ALWAYS" alignment="TOP_CENTER" style="-fx-alignment: TOP_CENTER;">
                <Button fx:id="btnDashboard" text="❖ Бърз Check-in" styleClass="sidebar-btn, sidebar-btn-active" onAction="#handleDashboardMenu"/>
                <Button fx:id="btnMembers" text="👥 Членове на клуба" styleClass="sidebar-btn" onAction="#handleMembersMenu"/>
                <Button fx:id="btnSchedule" text="📅 График и Тренировки" styleClass="sidebar-btn" onAction="#handleScheduleMenu"/>
                <Button fx:id="btnEquipment" text="🏋️‍♂️ Оборудване" styleClass="sidebar-btn" onAction="#handleEquipmentMenu"/>
                <Button fx:id="btnReports" text="📊 Отчети и Анализи" styleClass="sidebar-btn" onAction="#handleReportsMenu"/>
            </VBox>

            <Button text="⌱ Изход" styleClass="logout-btn"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-content-scroll">
            <VBox styleClass="main-content" spacing="25.0">
                <padding>
                    <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
                </padding>

                <Label text="Табло за управление" styleClass="dashboard-title"/>

                <HBox spacing="20.0" alignment="CENTER">
                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Circle radius="5.0" fill="#84cc16"/>
                            <Label text="Активни Членове" styleClass="kpi-title"/>
                        </HBox>
                        <Label text="1,240" styleClass="kpi-value"/>
                    </VBox>

                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="10.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Circle radius="5.0" fill="#eab308"/>
                            <Label text="Изтичащи Абонаменти (7 дни)" styleClass="kpi-title"/>
                        </HBox>
                        <Label text="42" styleClass="kpi-value"/>
                    </VBox>

                    <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="10.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Месечен Приход" styleClass="kpi-title"/>
                        </HBox>
                        <Label text="14,520 BGN" styleClass="kpi-value"/>
                    </VBox>
                </HBox>

                <VBox spacing="10.0" styleClass="table-section" VBox.vgrow="ALWAYS">
                    <Label text="График за Днес" styleClass="section-title"/>

                    <TableView fx:id="scheduleTable" prefHeight="350.0" styleClass="custom-table">
                        <columns>
                            <TableColumn fx:id="colTime" text="Час" prefWidth="120.0" />
                            <TableColumn fx:id="colClassName" text="Тренировка" prefWidth="250.0" />
                            <TableColumn fx:id="colCoach" text="Треньор" prefWidth="200.0" />
                            <TableColumn fx:id="colHall" text="Зала" prefWidth="150.0" />
                            <TableColumn fx:id="colSlots" text="Свободни места" prefWidth="250.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="backend.controllers.MembersController"
      stylesheets="@style.css" spacing="20.0" styleClass="main-content-scroll">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="Управление на членове" styleClass="dashboard-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Регистрирай нов член"
                styleClass="primary-action-btn"
                onAction="#handleRegisterNewMember"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="filter-bar">
        <padding>
            <Insets top="10.0" right="15.0" bottom="10.0" left="15.0"/>
        </padding>
        <TextField promptText="🔍 Търси по име, телефон или имейл..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
        <ComboBox promptText="Статус: Всички" styleClass="filter-combo"/>
        <ComboBox promptText="Абонамент: Всички" styleClass="filter-combo"/>
    </HBox>

    <TableView fx:id="membersTable" VBox.vgrow="ALWAYS" styleClass="custom-table, members-table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colName" text="Име" prefWidth="220.0"/>
            <TableColumn fx:id="colPhone" text="Телефон" prefWidth="130.0"/>
            <TableColumn fx:id="colEmail" text="Имейл" prefWidth="180.0"/>
            <TableColumn fx:id="colStatus" text="Статус" prefWidth="100.0" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colType" text="Тип абонамент" prefWidth="150.0"/>
            <TableColumn fx:id="colExpiry" text="Изтича на" prefWidth="120.0"/>
            <TableColumn fx:id="colActions" text="Действия" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label text="Показани 1-3 от 1,240 членове" styleClass="date-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5.0" alignment="CENTER">
            <Button text="&lt;" styleClass="pagination-btn"/>
            <Button text="1" styleClass="pagination-btn, pagination-btn-active"/>
            <Button text="2" styleClass="pagination-btn"/>
            <Button text="3" styleClass="pagination-btn"/>
            <Label text="..." style="-fx-padding: 0 5 0 5;"/>
            <Button text="124" styleClass="pagination-btn"/>
            <Button text="&gt;" styleClass="pagination-btn"/>
        </HBox>
    </HBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="backend.controllers.ScheduleController"
      stylesheets="@style.css" spacing="20.0" styleClass="main-content-scroll">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <!-- HEADER SECTION -->
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="График и групови тренировки" styleClass="dashboard-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10.0">
            <Button text="⚙ Управление на типове" styleClass="secondary-action-btn"/>
            <Button text="+ Нова тренировка" styleClass="primary-action-btn" onAction="#onCreateTraining"/>
        </HBox>
    </HBox>

    <!-- CALENDAR NAVIGATION & FILTER BAR -->
    <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="filter-bar">
        <padding>
            <Insets top="12.0" right="15.0" bottom="12.0" left="15.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button text="&lt;" styleClass="pagination-btn" onAction="#handlePreviousWeek"/>
            <Button text="Днес" styleClass="pagination-btn" style="-fx-pref-width: 60px;" onAction="#handleCurrentWeek"/>
            <Button text="&gt;" styleClass="pagination-btn" onAction="#handleNextWeek"/>
            <Label fx:id="lblWeekRange" text="Зареждане..." style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1D20; -fx-padding: 0 0 0 10;"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox styleClass="segmented-group">
            <Button fx:id="btnViewDay" text="Ден" styleClass="segmented-btn" onAction="#handleViewDay"/>
            <Button fx:id="btnViewWeek" text="Седмица" styleClass="segmented-btn, segmented-btn-active" onAction="#handleViewWeek"/>
            <Button fx:id="btnViewMonth" text="Месец" styleClass="segmented-btn" onAction="#handleViewMonth"/>
        </HBox>

        <ComboBox
                fx:id="trainerFilter"
                promptText="Всички треньори"
                styleClass="filter-combo"
                style="-fx-pref-width: 180px;"
        />

        <ComboBox
                fx:id="typeFilter"
                promptText="Всички типове"
                styleClass="filter-combo"
                style="-fx-pref-width: 180px;"
        />
    </HBox>

    <!-- WEEKLY TIMETABLE GRID (Календар) -->
    <ScrollPane fitToWidth="true" styleClass="calendar-scroll" VBox.vgrow="ALWAYS">
        <GridPane fx:id="calendarGrid" styleClass="calendar-grid" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints prefWidth="80.0" minWidth="80.0" halignment="CENTER" /> <!-- Колона за Часовете -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Понеделник -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Вторник -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Сряда -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Четвъртък -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Петък -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Събота -->
                <ColumnConstraints hgrow="ALWAYS" minWidth="130.0" /> <!-- Неделя -->
            </columnConstraints>
        </GridPane>
    </ScrollPane>
</VBox>